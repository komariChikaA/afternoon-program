        "width": 0.28,
        "height": 0.31,
        "opacity": 1
      },
      "animation": "none"
    },
    "speaker": "",
    "text": "麦子从椅子底下钻出来，把额头顶到我的膝盖上。",
    "id": "day1-pet"
  },
  {
    "bg": "living",
    "location": "一楼 · 客厅",
    "clock": "星期四 · 14:32",
    "audio": "program",
    "character": {
      "src": "assets/generated/characters/mugi.svg",
      "alt": "麦子的占位插画",
      "style": {
        "x": 0.56,
