[
  {
    "bg": "living",
    "location": "一楼 · 客厅",
    "clock": "星期四 · 14:32",
    "audio": "house",
    "speaker": "舅公",
    "text": "下午他们要来做节目。"
  },
  {
    "bg": "living",
    "location": "一楼 · 客厅",
    "clock": "星期四 · 14:32",
    "audio": "house",
    "speaker": "我",
    "text": "又来？"
  },
  {
    "bg": "living",
    "location": "一楼 · 客厅",
    "clock": "星期四 · 14:32",
    "audio": "house",
    "speaker": "舅公",
    "text": "你小时候还看过呢。"
  },
  {
    "bg": "living",
    "location": "一楼 · 客厅",
    "clock": "星期四 · 14:32",
    "audio": "house",
    "speaker": "我",
    "text": "现在还做？"
  },
  {
    "bg": "living",
    "location": "一楼 · 客厅",
    "clock": "星期四 · 14:32",
    "audio": "house",
    "speaker": "舅公",
    "text": "闲着也是闲着。坐着聊两句。"
  },
  {
    "bg": "living",
    "location": "一楼 · 客厅",
    "clock": "星期四 · 14:32",
    "audio": "house",
    "speaker": "",
    "text": "他说得像约人来下棋。随后从电视柜里拿出一个灰色的小摄像机。"
  },
  {
    "bg": "living",
    "location": "一楼 · 客厅",
    "clock": "星期四 · 14:32",
    "audio": "house",
    "speaker": "",
    "text": "线够不到插座。他把电视柜拉出来一点，还是不够，只好去厨房拿插线板。"
  },
  {
    "bg": "living",
    "location": "一楼 · 客厅",
    "clock": "星期四 · 14:32",
    "audio": "house",
    "speaker": "舅公",
    "text": "别绊着。等会儿收。"
  },
  {
    "bg": "living",
    "location": "一楼 · 客厅",
    "clock": "星期四 · 14:32",
    "audio": "house",
    "speaker": "",
    "text": "门铃连着响了两次。他没去看猫眼，只从厨房喊了一声进来。"
  },
  {
    "bg": "living",
    "location": "一楼 · 客厅",
    "clock": "星期四 · 14:32",
    "audio": "house",
    "speaker": "",
    "text": "先到的是二姨婆。她拎着一袋豆角，问我怎么又瘦了。"
  },
  {
    "bg": "living",
    "location": "一楼 · 客厅",
    "clock": "星期四 · 14:32",
    "audio": "house",
    "speaker": "二姨婆",
    "text": "是不是不按时吃饭？"
  },
  {
    "bg": "living",
    "location": "一楼 · 客厅",
    "clock": "星期四 · 14:32",
    "audio": "house",
    "speaker": "我",
    "text": "刚在车上吃过。"
  },
  {
    "bg": "living",
    "location": "一楼 · 客厅",
    "clock": "星期四 · 14:32",
    "audio": "house",
    "speaker": "二姨婆",
    "text": "车上吃的算什么饭。"
  },
  {
    "bg": "living",
    "location": "一楼 · 客厅",
    "clock": "星期四 · 14:32",
    "audio": "house",
    "speaker": "",
    "text": "林爷爷跟在后面，灰蓝外套叠在胳膊上。他把鞋摆齐，才往客厅走。"
  },
  {
    "bg": "living",
    "location": "一楼 · 客厅",
    "clock": "星期四 · 14:32",
    "audio": "house",
    "speaker": "林爷爷",
    "text": "你还认得我？"
  },
  {
    "bg": "living",
    "location": "一楼 · 客厅",
    "clock": "星期四 · 14:32",
    "audio": "house",
    "speaker": "我",
    "text": "认得。你以前住后面那栋。"
  },
  {
    "bg": "living",
    "location": "一楼 · 客厅",
    "clock": "星期四 · 14:32",
    "audio": "house",
    "speaker": "林爷爷",
    "text": "现在也住后面那栋。"
  },
  {
    "bg": "living",
    "location": "一楼 · 客厅",
    "clock": "星期四 · 14:32",
    "audio": "house",
    "speaker": "",
    "text": "胡爷爷最后进来。她脖子上搭着一条细围巾，说路口的风大。"
  },
  {
    "bg": "living",
    "location": "一楼 · 客厅",
    "clock": "星期四 · 14:32",
    "audio": "house",
    "speaker": "舅公",
    "text": "你们先坐。杯子自己拿。"
  },
  {
    "bg": "living",
    "location": "一楼 · 客厅",
    "clock": "星期四 · 14:32",
    "audio": "house",
    "speaker": "",
    "text": "二姨婆自己进厨房拿杯子，顺手给我倒了一杯。他们来得比我勤。"
  },
  {
    "bg": "living",
    "location": "一楼 · 客厅",
    "clock": "星期四 · 14:32",
    "audio": "program",
    "tv": "recording",
    "speaker": "",
    "text": "摄像机架在几本杂志上。舅公拧紧支架，让镜头对准椅子。"
  },
  {
    "bg": "living",
    "location": "一楼 · 客厅",
    "clock": "星期四 · 14:32",
    "audio": "program",
    "tv": "recording",
    "speaker": "",
    "text": "电视亮起来。屏幕里也是他们俩，动作慢了半拍。"
  },
  {
    "bg": "living",
    "location": "一楼 · 客厅",
    "clock": "星期四 · 14:32",
    "audio": "program",
    "tv": "recording",
    "speaker": "",
    "text": "左边坐林爷爷，右边坐胡爷爷。舅公嫌他没穿外套不好看，他又套上了。"
  },
  {
    "bg": "living",
    "location": "一楼 · 客厅",
    "clock": "星期四 · 14:32",
    "audio": "program",
    "tv": "recording",
    "speaker": "",
    "text": "两人面对镜头坐着，中间露出一截靠背。"
  },
  {
    "bg": "living",
    "location": "一楼 · 客厅",
    "clock": "星期四 · 14:32",
    "audio": "program",
    "tv": "recording",
    "speaker": "舅公",
    "text": "今天的客人，都来齐了。"
  },
  {
    "bg": "living",
    "location": "一楼 · 客厅",
    "clock": "星期四 · 14:32",
    "audio": "program",
    "tv": "recording",
    "speaker": "二姨婆",
    "text": "少一个。你自己不算啊？"
  },
  {
    "bg": "living",
    "location": "一楼 · 客厅",
    "clock": "星期四 · 14:32",
    "audio": "program",
    "tv": "recording",
    "speaker": "舅公",
    "text": "我是主持，主持不算客人。"
  },
  {
    "bg": "living",
    "location": "一楼 · 客厅",
    "clock": "星期四 · 14:32",
    "audio": "program",
    "tv": "recording",
    "speaker": "",
    "text": "大家笑起来。胡爷爷的笑比电视里的声音早一点。"
  },
  {
    "bg": "living",
    "location": "一楼 · 客厅",
    "clock": "星期四 · 14:32",
    "audio": "program",
    "tv": "recording",
    "speaker": "舅公",
    "text": "第一个问题。今天中午吃了什么？"
  },
  {
    "bg": "living",
    "location": "一楼 · 客厅",
    "clock": "星期四 · 14:32",
    "audio": "program",
    "tv": "recording",
    "speaker": "林爷爷",
    "text": "昨天剩的面。"
  },
  {
    "bg": "living",
    "location": "一楼 · 客厅",
    "clock": "星期四 · 14:32",
    "audio": "program",
    "tv": "recording",
    "speaker": "舅公",
    "text": "那不算今天的。"
  },
  {
    "bg": "living",
    "location": "一楼 · 客厅",
    "clock": "星期四 · 14:32",
    "audio": "program",
    "tv": "recording",
    "speaker": "林爷爷",
    "text": "我今天吃的，怎么不算？"
  },
  {
    "bg": "living",
    "location": "一楼 · 客厅",
    "clock": "星期四 · 14:32",
    "audio": "program",
    "tv": "recording",
    "speaker": "",
    "text": "二姨婆轻轻鼓掌。她手上还带着择豆角的水，拍完擦在裤子上。"
  },
  {
    "bg": "living",
    "location": "一楼 · 客厅",
    "clock": "星期四 · 14:32",
    "audio": "program",
    "tv": "recording",
    "speaker": "",
    "text": "舅公对着话筒说了半天，二姨婆提醒他：你这个没开。"
  },
  {
    "bg": "living",
    "location": "一楼 · 客厅",
    "clock": "星期四 · 14:32",
    "audio": "program",
    "tv": "recording",
    "speaker": "舅公",
    "text": "重来。刚才那段不算。"
  },
  {
    "bg": "living",
    "location": "一楼 · 客厅",
    "clock": "星期四 · 14:32",
    "audio": "program",
    "tv": "recording",
    "speaker": "胡爷爷",
    "text": "算不算谁知道？又没有别人看。"
  },
  {
    "bg": "living",
    "location": "一楼 · 客厅",
    "clock": "星期四 · 14:32",
    "audio": "program",
    "tv": "recording",
    "speaker": "",
    "text": "他们又从吃面开始说。我在后面笑得停不下来。",
    "sfx": "applause"
  },
  {
    "bg": "living",
    "location": "一楼 · 客厅",
    "clock": "星期四 · 14:32",
    "audio": "program",
    "tv": "recording",
    "id": "day1-observe",
    "speaker": "",
    "text": "他们讨论起晚饭。离下一道问题还有一会儿。",
