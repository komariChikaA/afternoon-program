  {
    "bg": "living-blood",
    "location": "一楼 · 客厅",
    "clock": "星期五 · 14:32",
    "audio": "quiet",
    "tv": "still",
    "closeTV": false,
    "speaker": "",
    "text": "我找了块没沾血的地方，把杯子放下。先不洗了。"
  },
