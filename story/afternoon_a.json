  {
    "bg": "living-blood",
    "location": "一楼 · 客厅",
    "clock": "星期五 · 14:32",
    "audio": "quiet",
    "tv": "still",
    "closeTV": false,
    "speaker": "",
    "text": "他看过来，手上还搭着一块布。"
  },
  {
    "bg": "living-blood",
    "location": "一楼 · 客厅",
    "clock": "星期五 · 14:32",
    "audio": "quiet",
    "tv": "still",
    "closeTV": false,
    "speaker": "舅公",
    "text": "钥匙放门边。路上小心。"
  },
  {
    "bg": "living-blood",
    "location": "一楼 · 客厅",
    "clock": "星期五 · 14:32",
    "audio": "quiet",
    "tv": "still",
    "closeTV": false,
    "speaker": "我",
    "text": "好。"
