        "height": 0.31,
        "opacity": 1
      },
      "animation": "none"
    },
    "speaker": "",
    "text": "我没碰那道缝。它把额头抵在我手上。"
  },
  {
    "bg": "living-repeat",
    "location": "一楼 · 客厅",
    "clock": "星期四 · 14:32",
    "audio": "program",
    "closeTV": false,
    "character": {
      "src": "assets/generated/characters/mugi.svg",
