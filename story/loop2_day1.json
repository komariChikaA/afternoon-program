        "height": 0.31,
        "opacity": 1
      },
      "animation": "none"
    },
    "speaker": "",
    "text": "这次它没有直立。它只把鼻子靠在我的掌心，身子还是贴着地。"
  },
  {
    "bg": "living-repeat",
    "location": "一楼 · 客厅",
    "clock": "星期四 · 14:32",
    "audio": "program",
    "closeTV": false,
    "character": {
      "src": "assets/generated/characters/mugi.svg",
