        "opacity": 1
      },
      "animation": "none"
    },
    "speaker": "",
    "text": "腹部的毛被压成一道细缝。它转身时，用前脚护了一下那个地方。"
  },
  {
    "bg": "living-repeat",
    "location": "一楼 · 客厅",
    "clock": "星期四 · 14:32",
    "audio": "program",
    "closeTV": false,
    "character": {
      "src": "assets/generated/characters/mugi.svg",
