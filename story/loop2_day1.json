      "style": {
        "x": 0.56,
        "y": 0.4,
        "width": 0.28,
        "height": 0.31,
        "opacity": 1
      },
      "animation": "none"
    },
    "speaker": "我",
    "text": "等会儿再给你饼干。"
  },
  {
    "bg": "living-repeat",
    "location": "一楼 · 客厅",
    "clock": "星期四 · 14:32",
    "audio": "program",
    "closeTV": false,
    "character": {
      "src": "assets/generated/characters/mugi.svg",
