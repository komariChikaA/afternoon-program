        "y": 0.4,
        "width": 0.28,
        "height": 0.31,
        "opacity": 1
      },
      "animation": "none"
    },
    "speaker": "",
    "text": "电视里的脸靠得太近了。我挪开眼睛，不敢再看。"
  },
  {
    "bg": "living-blood-repeat",
    "location": "一楼 · 客厅",
    "clock": "星期五 · 14:32",
    "audio": "fear",
