        "y": 0.4,
        "width": 0.28,
        "height": 0.31,
        "opacity": 1
      },
      "animation": "none"
    },
    "speaker": "",
    "text": "我往后缩了一点，把钥匙攥在手里。"
  },
  {
    "bg": "living-blood-repeat",
    "location": "一楼 · 客厅",
    "clock": "星期五 · 14:32",
    "audio": "fear",
    "tv": "cartoon",
    "fear": true,
