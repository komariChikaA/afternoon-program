        "width": 0.28,
        "height": 0.31,
        "opacity": 1
      },
      "animation": "none"
    },
    "speaker": "",
    "text": "我站在舅公面前。他的手还没放下。"
  },
  {
    "bg": "living-blood-repeat",
    "location": "一楼 · 客厅",
    "clock": "星期五 · 14:32",
    "audio": "fear",
