        "height": 0.31,
        "opacity": 1
      },
      "animation": "none"
    },
    "speaker": "",
    "text": "早上她还问我要不要再盛一碗。"
  },
  {
    "bg": "living-blood-repeat",
    "location": "一楼 · 客厅",
    "clock": "星期五 · 14:32",
