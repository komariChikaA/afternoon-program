    "bg": "guest",
    "location": "二楼 · 客房",
    "clock": "星期五 · 13:50",
    "audio": "house",
    "speaker": "",
    "text": "楼下没声音了。"
  },
  {
    "bg": "guest",
    "location": "二楼 · 客房",
    "clock": "星期五 · 13:50",
    "audio": "house",
    "speaker": "",
